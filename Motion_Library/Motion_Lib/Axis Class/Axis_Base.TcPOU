    </Property>
    <Method Name="FB_Init" Id="{b79a0e62-0ee6-47b6-874a-a1e2579a6c1b}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change) 
	Axis : Reference TO AXIS_REF;  
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[EnableBehaviour.AxisRef REF= axis;
DefaultResetBehaviour.AxisRef REF= axis;
DefaultMoveBehaviour.AxisRef REF= axis;
DefaultVeloBehaviour.AxisRef REF= axis;
DefaultJogBehaviour.AxisRef REF= axis;
DefaultRelBehaviour.AxisRef REF= axis;
DefaultModBehaviour.AxisRef REF= axis;
HaltBehaviour.AxisRef REF= axis;
_axis REF= Axis;

DefaultJogBehaviour.RegisterWithParent(Parent := TaskCollection);
DefaultModBehaviour.RegisterWithParent(Parent := TaskCollection);
DefaultMoveBehaviour.RegisterWithParent(Parent := TaskCollection);
DefaultRelBehaviour.RegisterWithParent(Parent := TaskCollection);
DefaultJogBehaviour.RegisterWithParent(Parent := TaskCollection);
DefaultVeloBehaviour.RegisterWithParent(Parent := TaskCollection);
HaltBehaviour.RegisterWithParent(Parent := TaskCollection);
DefaultResetBehaviour.RegisterWithParent(Parent := TaskCollection);
EnableBehaviour.RegisterWithParent(Parent := TaskCollection);]]></ST>
      </Implementation>
    </Method>
    <Method Name="HaltAxis" Id="{b5b4d676-a559-4d25-8571-0c2ec9c3c015}" FolderPath="Base\">
      <Declaration><![CDATA[METHOD PUBLIC HaltAxis : HRESULT
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT HaltBehaviour.Busy THEN
	HaltAxis := HaltBehaviour.Execute();
	DefaultMoveBehaviour.Abort();
	DefaultVeloBehaviour.Abort();
ELSE 
	HaltAxis := -1;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="HasError" Id="{a508d66e-2c23-49e5-bf01-8d54382ab174}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY HasError : BOOL]]></Declaration>
      <Get Name="Get" Id="{26e58127-3309-47b3-91dd-05ea60bb0e3f}">
