END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[HasError := _axis.Status.Error;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Inch" Id="{a8ecae9a-5934-4e49-93bc-ed8a7c89528c}" FolderPath="Manual\">
      <Declaration><![CDATA[METHOD Inch : HRESULT
VAR_INPUT
	Distance : MC_LREAL;
	Direction : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF FAILED( DefaultJogBehaviour.Inch(Distance, Direction)) THEN
	Inch := -1;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="InTargetPosition" Id="{9abca603-e884-4f4f-bccc-fc41fc8ff5ee}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY InTargetPosition : BOOL]]></Declaration>
      <Get Name="Get" Id="{25924b82-ccca-4ae9-aec4-bfae0b30c843}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[InTargetPosition := _axis.Status.InTargetPosition;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="InVelocity" Id="{58797bbc-1847-4345-b88d-e9a061a816ed}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY InVelocity : BOOL]]></Declaration>
      <Get Name="Get" Id="{2d341fd7-f727-4430-a670-3040afdfb9d4}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[InVelocity := ABS(_axis.NcToPlc.ActVelo) < DemandVelo + (DemandVelo * 0.02) AND 
				ABS(_axis.NcToPlc.ActVelo) > DemandVelo - (DemandVelo * 0.02);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="IsCoupled" Id="{6b5c09b2-f69c-4bfa-8f55-e28d0dee4f96}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY IsCoupled : bool]]></Declaration>
      <Get Name="Get" Id="{5710167e-5ed2-4c8f-a7c3-1f2e8d1de119}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[isCoupled := _axis.Status.Coupled;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="IsEnabled" Id="{61d475f5-477d-4a41-ac2b-c5e94d4efd87}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY IsEnabled : bool]]></Declaration>
      <Get Name="Get" Id="{c410a671-3e66-4117-ad8d-e6127a67edec}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[isEnabled := not _axis.Status.Disabled;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="IsStationary" Id="{c81c5586-ca5c-467c-9e94-5811eaa88ec6}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY IsStationary : bool]]></Declaration>
      <Get Name="Get" Id="{ee3f5e21-c9c4-44e4-88f0-3b457286107f}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[isStationary := NOT _axis.Status.HasJob AND _axis.Status.NotMoving;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Jerk" Id="{79ff8a18-6bf8-46ba-a24c-7f84c4790e08}" FolderPath="Dynamics\">
