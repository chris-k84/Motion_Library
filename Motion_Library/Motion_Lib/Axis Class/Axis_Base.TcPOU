    <Method Name="Cycle" Id="{6e2b69ab-f1bf-4962-bdbb-f480f753daf6}">
      <Declaration><![CDATA[METHOD Cycle : HRESULT
VAR_INST
	
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_axis.ReadStatus();
axesReadError(Axis := _axis, Enable := TRUE, AxisErrorID => _ErrorId);
TaskCollection.Cycle();

_Operating := DefaultMoveBehaviour.Busy OR DefaultRelBehaviour.Busy OR DefaultModBehaviour.Busy OR DefaultVeloBehaviour.Busy;]]></ST>
      </Implementation>
    </Method>
