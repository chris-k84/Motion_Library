      </Set>
    </Property>
    <Method Name="JogFast" Id="{95cc0a16-a1bd-4e7f-963c-68820a459e0a}" FolderPath="Manual\">
      <Declaration><![CDATA[METHOD JogFast : HRESULT
VAR_INPUT
	Direction : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF FAILED(DefaultJogBehaviour.JogFast(Direction)) THEN
	JogFast := -1;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="JogSlow" Id="{6f896ef2-e375-4b54-96df-82c467e4828a}" FolderPath="Manual\">
      <Declaration><![CDATA[METHOD JogSlow : HRESULT
VAR_INPUT
	Direction : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF FAILED(DefaultJogBehaviour.JogSlow(Direction)) THEN
	JogSlow := -1;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveAtVelocity" Id="{6d3a50a7-ce83-4f3f-b972-fcb26bf76028}" FolderPath="Velocity\">
      <Declaration><![CDATA[METHOD MoveAtVelocity : HRESULT
VAR_INPUT
	Direction : MC_Direction;
	Velocity : MC_LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Velocity = 0 THEN 
	MoveAtVelocity := -1;
	RETURN;
END_IF

IF SUCCEEDED(DefaultVeloBehaviour.MoveAtVelocity(Direction, Velocity)) THEN
	DemandVelo := Velocity;
ELSE
	MoveAtVelocity := -1;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveByDistance" Id="{957d5870-8bcd-44f2-a483-ac5c3f32f182}" FolderPath="Position\">
      <Declaration><![CDATA[METHOD MoveByDistance : HRESULT
VAR_INPUT
	Distance : MC_LREAL;
	Velocity : MC_LREAL;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF ABS(Distance) = 0 THEN
	MoveByDistance := -1;
	RETURN;
END_IF
IF _axis.Status.Disabled THEN
	MoveByDistance := -2;
	RETURN;
END_IF

IF _axis.Status.Error THEN
	MoveByDistance := -3;
	RETURN;
END_IF

DefaultRelBehaviour.MoveBy(Distance,Velocity);]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveToModuloPosition" Id="{470f0d21-ab3e-4d10-948f-9938775e223b}" FolderPath="Position\">
      <Declaration><![CDATA[METHOD MoveToModuloPosition : HRESULT
VAR_INPUT
	Position : MC_LREAL;
	Velocity : MC_LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Velocity = 0 THEN
	MoveToModuloPosition := -1;
	RETURN;
END_IF

IF _axis.Status.Disabled THEN
	MoveToModuloPosition := -2;
	RETURN;
END_IF

IF _axis.Status.Error THEN
	MoveToModuloPosition := -3;
	RETURN;
END_IF

DefaultModBehaviour.MoveTo(Position,Velocity);]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveToPosition" Id="{bca42834-4b90-4808-be50-ee67839e4111}" FolderPath="Position\">
      <Declaration><![CDATA[METHOD PUBLIC MoveToPosition : HRESULT
VAR_INPUT
	Position : MC_LREAL;
	Velocity : MC_LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Velocity = 0 THEN
	Base_Library.Tracing.Trace.Warning(TO_STRING(_axis.NcToPlc.AxisId), 'Abs Move Fail - 0 Velo');
	MoveToPosition := -1;
	RETURN;
END_IF

IF _axis.Status.Disabled THEN
	Base_Library.Tracing.Trace.Warning(TO_STRING(_axis.NcToPlc.AxisId), 'Abs Move Fail - Disabled');
	MoveToPosition := -2;
	RETURN;
END_IF

IF _axis.Status.Error THEN
	Base_Library.Tracing.Trace.Warning(TO_STRING(_axis.NcToPlc.AxisId), 'Abs Move Fail - Error');
	MoveToPosition := -3;
	RETURN;
END_IF

Base_Library.Tracing.Trace.Verbose(TO_STRING(_axis.NcToPlc.AxisId), 'Abs Move Success');
DefaultMoveBehaviour.MoveTo(Position,Velocity);]]></ST>
      </Implementation>
    </Method>
    <Property Name="Operating" Id="{2826cb54-890e-4680-8351-f7a1832e17c1}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY Operating : BOOL]]></Declaration>
      <Get Name="Get" Id="{c0bb9c85-969d-4c91-8860-481e57e53007}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Operating := _Operating;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="RegisterWithParent" Id="{381741fc-fc26-4603-bb08-86e14ada8bdb}">
      <Declaration><![CDATA[METHOD RegisterWithParent
VAR_INPUT
	Parent	: Base_Library.I_HostObjects;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Parent.RegisterCyclic(THIS^);
Parent.RegisterResettable(THIS^);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{bd5b60f2-6a45-4850-931f-c2efbdee4a44}" FolderPath="Base\">
      <Declaration><![CDATA[METHOD PUBLIC Reset : HRESULT
VAR
	ResetResult : HRESULT;
	MoveAbortResult : BOOL;
	HaltAbortResult : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TaskCollection.Reset();
//TaskCollection.Abort();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>